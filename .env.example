# ========================================================
#  LANFlixx Configuration Template
# ========================================================

# The port where LANFlixx server will run
PORT=5000

# The absolute path to your movie/video folder on your host machine
# Windows example: D:\film or C:\Users\YourName\Videos
# Linux/macOS example: /media/movies or /home/user/Movies
FILM_DIR=D:\film
